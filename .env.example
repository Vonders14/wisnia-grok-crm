# Client (browser) — never put a service_role key here.
# In mock mode these are unused; leave blank for local `npm run dev`.
VITE_DATA_MODE=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: browser talks to the read-only proxy instead of Supabase directly.
VITE_API_BASE_URL=http://localhost:8787

# Server-side proxy only (`npm run dev:proxy`). Holds the key off the browser.
# Prefer a dedicated read-only key / RLS-scoped anon once Devon approves policies.
# Until then, a service_role key may live HERE only — never in VITE_* vars.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PROXY_PORT=8787
PROXY_ALLOWED_ORIGIN=http://localhost:5173
